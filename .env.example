# Envío de OTP delegado al microservicio SoundMe-MailRelay (Railway bloquea SMTP
# saliente en el plan Hobby). MAIL_RELAY_API_KEY debe coincidir con RELAY_API_KEY
# configurado en ese servicio.
MAIL_RELAY_URL=https://mail-relay.tu-dominio.com
MAIL_RELAY_API_KEY=replace-with-a-long-random-secret
MAIL_RELAY_TIMEOUT=10

# Base de datos y Django
SECRET_KEY=replace-this-secret-key
DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://soundme-backoffice-production.up.railway.app
