# SMTP con Resend
# Crea la API key en Resend y nunca la subas al repositorio.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxxxxxxx
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_TIMEOUT=10
# Para desarrollo: SoundMe <onboarding@resend.dev>
# Para produccion: SoundMe <noreply@tu-dominio-verificado.com>
DEFAULT_FROM_EMAIL=SoundMe <onboarding@resend.dev>

# Base de datos y Django
SECRET_KEY=replace-this-secret-key
DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3
