# SMTP
# Gmail requiere una contrasena de aplicacion, no la contrasena normal.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-cuenta@gmail.com
EMAIL_HOST_PASSWORD=tu-contrasena-de-aplicacion
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=tu-cuenta@gmail.com

# Base de datos y Django
SECRET_KEY=replace-this-secret-key
DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3
